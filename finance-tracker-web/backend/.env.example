# Application Settings
APP_NAME=Finance Tracker API
VERSION=1.0.0
DEBUG=False

# Database Configuration
# Render PostgreSQL database URL (automatically set by Render)
DATABASE_URL=postgresql://finance_tracker_user:YOUR_PASSWORD@db.onrender.com:5432/finance_tracker

# For local development
# DATABASE_URL=postgresql://username:password@localhost:5432/finance_tracker

# Security Settings
SECRET_KEY=change-this-to-a-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Origins (comma-separated list)
# Add your frontend URL here
# Render will set FRONTEND_URL automatically
BACKEND_CORS_ORIGINS=["http://localhost:8080"]
